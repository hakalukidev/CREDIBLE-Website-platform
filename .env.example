# Database
DATABASE_URL="postgresql://credible:credible@localhost:5432/credible?schema=public"

# Backend API
NODE_ENV="development"
PORT=4000
API_PREFIX="/api/v1"
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# AWS S3 / Cloudflare R2
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="credible-documents"
S3_PUBLIC_BUCKET="credible-public"

# OAuth (Passport.js)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:4000/api/v1/auth/facebook/callback"

# SMTP (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Credible <noreply@credible.example>"

# SendGrid (alternative)
SENDGRID_API_KEY=""

# OTP
OTP_EXPIRES_IN_SECONDS=600
OTP_LENGTH=6

# AI / Vision (Phase 3)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Payments - aamarPay (Phase 4)
AAMARPAY_STORE_ID=""
AAMARPAY_SIGNATURE_KEY=""
AAMARPAY_SANDBOX=true
AAMARPAY_SUCCESS_URL="http://localhost:4000/api/v1/payments/aamarpay/success"
AAMARPAY_FAIL_URL="http://localhost:4000/api/v1/payments/aamarpay/fail"
AAMARPAY_CANCEL_URL="http://localhost:4000/api/v1/payments/aamarpay/cancel"

# Payments - SSLCommerz (Phase 4)
SSLCZ_STORE_ID=""
SSLCZ_STORE_PASSWORD=""
SSLCZ_SANDBOX=true
SSLCZ_SUCCESS_URL="http://localhost:4000/api/v1/payments/sslcommerz/success"
SSLCZ_FAIL_URL="http://localhost:4000/api/v1/payments/sslcommerz/fail"
SSLCZ_CANCEL_URL="http://localhost:4000/api/v1/payments/sslcommerz/cancel"
SSLCZ_IPN_URL="http://localhost:4000/api/v1/payments/ipn/sslcommerz"

# Invoicing (Phase 4) — Bangladesh VAT applied to invoices
INVOICE_VAT_RATE=0.05

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL="info"
