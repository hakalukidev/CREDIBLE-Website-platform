# Frontend (Next.js) — environment variables
# Copy to .env and fill in real values. Never commit .env.
# All variables exposed to the browser MUST be prefixed with NEXT_PUBLIC_.

# Backend API base URL (used by the browser)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Public site URL (used for absolute URLs in metadata / sitemap)
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# Optional: name of the site (overridden by i18n if you add one)
NEXT_PUBLIC_SITE_NAME="Credible"

# Admin panel JWT secret. MUST match the backend's JWT_ADMIN_SECRET. Used only
# server-side (frontend/src/middleware.ts) to verify admin JWTs in the cookie.
# Do NOT prefix with NEXT_PUBLIC_ — it must never reach the browser bundle.
JWT_ADMIN_SECRET="change-me-admin-secret"